# MODO PADRÃO: opções binárias cripto; sem Spot/Futuros.
# Atualizações preservam ASSETS do seu .env. Os sete pares de moedas antigos
# são reconhecidos automaticamente; não troque os pares para atualizar o app.
# ASSET_SCOPE opcional: forex ou crypto_binary; vazio identifica a allowlist.
# Ativos /USD são nomes de contratos; disponibilidade real depende do catálogo Deriv.
# Condições de CALL/PUT e payout >=90% exigem confirmação pública antes do sinal.
DATA_PROVIDER=deriv
STRATEGY=scan_all
ASSETS=ADA/USD,APT/USD,ARB/USD,ATOM/USD,AVAX/USD,BCH/USD,ICP/USD,IMX/USD,INJ/USD,LINK/USD,LTC/USD,NEAR/USD,BTC/USD,DOGE/USD,DOT/USD,ETC/USD,ETH/USD,FIL/USD
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chaves dos planetas ficam somente no backend. Cada modelo só ativa após
# validação exata no endpoint /models do provedor.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
# Chaves opcionais por planeta; vazio reutiliza NVIDIA_API_KEY.
NEMOTRON_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
NVIDIA_TREND_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_GLM_MODEL=z-ai/glm-5-3
# Defina somente após confirmar a compatibilidade do modelo no catálogo NVIDIA.
NVIDIA_KIMI_MODEL=
GEMINI_API_KEY=
# Defina somente para um modelo listado e compatível com resposta JSON.
GEMINI_MODEL=
DATABASE_PATH=data/aurora.db
# Entrada precisa caber na janela original do padrão, com pelo menos 60s de antecedência.
# Em produção, confirmações fechadas passam pelas IAs e pela proposta de payout.
# Gatilhos intravela legados não emitem sem essa validação; use M5.
# Provedores nativos recebem ticks contínuos, com idade máxima de 10s.
# A entrada é programada dentro da janela; não há execução imediata ao toque.
MIN_LEAD_SECONDS=60
# Idade máxima em M5; demais períodos usam intervalo + 30 segundos
MAX_DATA_AGE_SECONDS=330
CONFIRM_HTF=false
# Pesquisa opcional nos logs, sem criar sinais nem enviar Telegram.
# Vazio = desligado. Quatro módulos opcionais não SMC, incluindo terceiro toque.
EXPERIMENTAL_STRATEGIES=
# EXPERIMENTAL_STRATEGIES=structure_pullback,breakout_retest,range_reversal,third_touch
# Coleta prospectiva em banco separado. Pode consultar a API para revalidação/apuração.
# Nunca envia sinais experimentais ao painel/Telegram; não alimenta o aprendizado.
EXPERIMENTAL_COLLECT=false
# Cada filtro selecionado gera uma comparação isolada com o módulo sem esse filtro.
# Nomes: regime_alignment,htf_alignment,volatility_band,location_room,stretch_ema,opposing_wick
EXPERIMENTAL_FILTERS=

# Comparadores das famílias do manual em observação. Desligado por padrão; sem Telegram.
# Usa banco .selection.db, mesmas consultas de análise e apuração/revalidação agrupadas.
SELECTION_OBSERVATION=false

# HOSPEDAGEM PÚBLICA (opcional, DESLIGADA por padrão)
# Sem estas configurações válidas o contêiner permanece restrito a loopback.
AURORA_PUBLIC_MODE=false
# Exemplo: https://seu-projeto.up.railway.app (origem HTTPS, sem / final)
AURORA_PUBLIC_ORIGIN=
# Gere ambos com: python scripts/generate_admin_hash.py
# Armazene como variáveis privadas da plataforma; não envie valores reais no ZIP/Git.
AURORA_ADMIN_PASSWORD_HASH=
AURORA_SESSION_SECRET=
# Na Railway, configure DATABASE_PATH=/app/data/aurora.db e monte volume em /app/data.
